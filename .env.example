# Port hôte exposé par le conteneur Postgres (changer si un autre Postgres occupe déjà 5432)
POSTGRES_PORT=5432

# URL de connexion à la base de données PostgreSQL locale (voir docker-compose.yml)
# Le port doit correspondre à POSTGRES_PORT ci-dessus.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_template

# Clé secrète utilisée par Better Auth pour signer/chiffrer sessions et jetons.
# Générer une valeur unique par environnement avec `openssl rand -base64 32`.
# Doit contenir au moins 32 caractères (validé au démarrage, voir src/lib/env.ts).
BETTER_AUTH_SECRET=

# URL de base de l'application, utilisée par Better Auth pour construire les
# liens (ex. réinitialisation de mot de passe) et valider les requêtes.
BETTER_AUTH_URL=http://localhost:3000
